// REFERENCE ONLY. No wrangler.jsonc, active cron, credentials, or account ID.
// Deliberately invalid entrypoint: even --config this-file cannot deploy.
{
  "name": "private-forecast-pilot-not-approved",
  "main": "DO-NOT-DEPLOY-MISSING-ENTRYPOINT.mjs",
  "compatibility_date": "2026-10-22",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  "vars": {"PILOT_ENABLED": "false", "DRY_RUN": "true"},
  "ai": {"binding": "AI"},
  "durable_objects": {"bindings": [{"name": "PILOT", "class_name": "ForecastPilot"}]},
  "migrations": [{"tag": "v1", "new_sqlite_classes": ["ForecastPilot"]}]
}
